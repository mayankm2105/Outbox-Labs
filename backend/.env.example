NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5434/reachinbox

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-secret-string
SESSION_TTL_SECONDS=86400

# ─── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ─── Ethereal SMTP ─────────────────────────────────────────────────────────────
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# ─── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Slack ─────────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/v1/integrations/slack/callback

# ─── Worker Concurrency ────────────────────────────────────────────────────────
EMAIL_WORKER_CONCURRENCY=5
NOTIFICATION_WORKER_CONCURRENCY=2

# ─── Retry Configuration ───────────────────────────────────────────────────────
EMAIL_MAX_RETRIES=5
EMAIL_RETRY_BASE_DELAY_MS=5000

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
GLOBAL_HOURLY_LIMIT=100
DEFAULT_EMAIL_DELAY_SECONDS=60

# ─── Campaign Limits ───────────────────────────────────────────────────────────
MAX_RECIPIENTS_PER_CAMPAIGN=500

# ─── Outbox & Reconciliation Polling ──────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=2000
RECONCILIATION_POLL_INTERVAL_MS=60000

# ─── Encryption ────────────────────────────────────────────────────────────────
# Must be a 64-character hex string (32 bytes). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

